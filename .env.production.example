# Production runtime configuration for docker-compose.prod.yml (Dokploy).
# Copy into Dokploy's Environment tab, or copy to .env.production and run:
# docker compose --env-file .env.production -f docker-compose.prod.yml config --quiet
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# Fill every required blank before deploying. Never commit the populated file.
# Requires an existing dokploy-network and reachable PostgreSQL 18+ database.

IMAGE_TAG=latest
APP_PUBLISHED_PORT=8000

# Required database connection. Host is the internal Dokploy database hostname.
# POSTGRES_DB is the application database, not the Zitadel database.
# User/password must be URI-safe or percent-encoded for the composed URL.
POSTGRES_HOST=
POSTGRES_DB=fabric_sync
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# Required API introspection credentials (separate from the SPA client).
OAUTH_ISSUER_URL=https://auth.example.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_INTROSPECTION_URL=
OAUTH_RESOURCE_AUDIENCE=

# Required application project and primary grant organization.
# Must match the VITE_ZITADEL_* values baked into the image.
ZITADEL_PROJECT_ID=
ZITADEL_ORGANIZATION_ID=
ZITADEL_TRUSTED_ORGANIZATION_IDS=
# Required dedicated machine user; grant ORG_USER_MANAGER for directory reads.
# Grant-read permission is also needed to display user roles.
ZITADEL_USERS_CLIENT_ID=
ZITADEL_USERS_CLIENT_SECRET=

TIMEZONE=Asia/Bahrain
RUST_LOG=info
SEED_DEV_DATA=false
# Enable explicitly to bootstrap the bundled design catalog.
SEED_DESIGN_OPTIONS=false

# VAT fraction, 0..1, at most six decimal places. New invoices use this rate.
VAT_RATE=0.10
# Set a positive charge before accepting urgent orders (e.g. 5).
# amount = fixed VAT-inclusive BHD; percent = percentage of garment price.
URGENT_ORDER_CHARGE=
URGENT_ORDER_CHARGE_UNIT=amount
# Set a positive VAT-inclusive BHD base before accepting customer fabric orders.
CUSTOMER_MATERIAL_BASE_PRICE=

# Invoice branding; optional fields are omitted when blank.
COMPANY_NAME_EN=Fabric Sync
COMPANY_NAME_AR=فابريك سينك
COMPANY_VAT_NUMBER=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS_EN=
COMPANY_ADDRESS_AR=
COMPANY_PHONE=
COMPANY_EMAIL=
# Self-contained data URI, not an HTTP URL.
COMPANY_LOGO_DATA_URL=
# Optional container directory; requires a read-only volume mount override.
# Blank uses templates embedded in the binary.
INVOICE_TEMPLATE_DIR=

# PDF renderer URL/profile are fixed in Compose to match its private service.
# WhatsApp delivery stays disabled until sender and templates are configured.
# See docs/whatsapp-notifications.md for setup and exact approved bodies.
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_REGION=BH
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_INVOICE_TEMPLATE=invoice_document_v1
WHATSAPP_READY_TEMPLATE=invoice_ready_v1
WHATSAPP_GIFT_CARD_TEMPLATE=gift_card_image_v1
# Blank bodies use built-in defaults; overrides must match approved templates.
# Gift card template requires an IMAGE header.
WHATSAPP_INVOICE_BODY=
WHATSAPP_READY_BODY=
WHATSAPP_GIFT_CARD_BODY=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DRAFT_RETENTION_DAYS=1
DOCUMENT_ORPHAN_RETENTION_DAYS=1
WHATSAPP_WEBHOOK_RETENTION_DAYS=90

# Frontend configuration is BUILD-TIME ONLY; adding VITE_* values here does
# not update a prebuilt image. Set these GitHub Actions repository variables
# and rerun the Docker workflow (or pass matching Docker build arguments):
# VITE_OIDC_AUTHORITY=https://auth.example.com
# VITE_OIDC_CLIENT_ID=<spa-client-id>
# VITE_ZITADEL_PROJECT_ID=<same-as-ZITADEL_PROJECT_ID>
# VITE_ZITADEL_ORGANIZATION_ID=<same-as-ZITADEL_ORGANIZATION_ID>
# VITE_ZITADEL_TRUSTED_ORGANIZATION_IDS=
# VITE_OIDC_REDIRECT_URI=https://app.example.com/
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://app.example.com/
# VITE_ACCOUNT_URL=
# Register both redirect URLs with the SPA provider, including trailing slash.
# Dockerfile defaults: VITE_API_BASE_URL=/api and
# VITE_OIDC_SCOPE="openid profile email offline_access".
