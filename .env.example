# ⚠️  INSECURE DEFAULTS — for local development only.
# Before exposing this stack to a network, change AUTHENTIK_SECRET_KEY and
# POSTGRES_ADMIN_PASSWORD.
#
# This file feeds two readers: `docker compose` (the infra below) and the
# backend itself (`dotenvy` in main.rs walks up to it when running
# `cargo run`), so backend and compose settings live side by side here.

# -----------------------------
# Backend (reads from process env / this file via dotenvy)
# -----------------------------
# Port 8000 keeps clear of the Vite dev server on :3000; it is also the
# target of Vite's `/api` proxy (see frontend/vite.config.ts BACKEND_URL).
PORT=8000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fabric_sync

# OIDC issuer for the SPA's OAuth2 provider in Authentik. The discovery
# document lives per provider, so this must include the full provider path
# (the `<slug>` chosen when creating the provider, e.g. `fabric-sync`):
#   http://localhost:9000/application/o/<slug>/
OAUTH_ISSUER_URL=http://localhost:9000/application/o/fabric-sync/
# Confidential provider used only to introspect end-user tokens
# (see "Authentik setup" below).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Authentik's introspection endpoint is global, not per-provider, and isn't
# advertised by per-provider discovery — always set this explicitly.
OAUTH_INTROSPECTION_URL=http://localhost:9000/application/o/introspect/
# Leave unset unless verified: Authentik's introspection response may not
# carry an `aud` claim, and a configured audience the response lacks turns
# every valid token into a 401.
# OAUTH_RESOURCE_AUDIENCE=

# -----------------------------
# Authentik user directory (backend)
# -----------------------------
# Backs GET /users (the order-stage assignee picker) with Authentik's real
# user directory. Both are required; a missing AUTHENTIK_API_TOKEN fails the
# backend at startup (see backend/src/features/users/authentik.rs).
#
# Base URL of the Authentik instance — the server root, NOT the per-provider
# OIDC issuer URL above (the API lives at the root: /api/v3/...).
AUTHENTIK_BASE_URL=http://localhost:9000
# Static API token for a service account that may list users. One-time
# setup in the Authentik admin UI (http://localhost:9000/if/admin/):
#   1. Directory > Users > Create > Service account (e.g. "fabric-sync-backend").
#   2. Give it permission to view users: a group/role granting
#      "View user" (authentik_core.view_user), assigned to that account.
#   3. That account > Tokens & App passwords > Create. Copy the token here —
#      it is shown once.
AUTHENTIK_API_TOKEN=

# -----------------------------
# Backend dev seed
# -----------------------------
# Loads backend/seeds/dev_seed.sql at startup — sample locations, materials,
# products, customers, invoices, and orders spread across the tracking stages.
# Run it as: SEED_DEV_DATA=true cargo run
# It refuses to run against a database that already has data, so it can never
# overwrite real rows.
SEED_DEV_DATA=false

# -----------------------------
# Authentik setup (console checklist)
# -----------------------------
# After `docker compose up -d --wait`, open http://localhost:9000/if/admin/
# (first boot shows the initial-setup flow that creates the `akadmin`
# superuser) and create, under Applications > Providers (OAuth2/OIDC):
#
# - Backend introspection provider — Name e.g. `fabric-sync-api`, Client
#   type Confidential. Copy its client ID/secret into OAUTH_CLIENT_ID /
#   OAUTH_CLIENT_SECRET above. No redirect URIs needed.
# - Frontend SPA provider — Name e.g. `fabric-sync`, Client type Public,
#   PKCE. Add redirect URIs for every origin the dev server is opened from
#   (e.g. http://localhost:3000/ and the Tailscale URL), each also as a
#   post-logout redirect URI. Its client ID goes into the frontend's
#   VITE_OIDC_CLIENT_ID, and its slug into OAUTH_ISSUER_URL /
#   VITE_OIDC_AUTHORITY above. Scopes: openid profile email.
# - Federation (required): on the SPA provider, add the introspection
#   provider under "Federated OAuth2/OpenID Providers" — otherwise the
#   backend cannot introspect the SPA's tokens and every call 401s.
#
# To upgrade Authentik, bump AUTHENTIK_VERSION and run:
#   docker compose --env-file .env -f docker-compose.yml pull
#   docker compose --env-file .env -f docker-compose.yml up -d --wait

# -----------------------------
# Pinned image tags
# -----------------------------
# Authentik releases: https://docs.goauthentik.io/releases — must stay on
# 2025.10+ (Redis-free; no redis service in this stack).
AUTHENTIK_VERSION=2026.8
POSTGRES_IMAGE=postgres:18.4-alpine

# -----------------------------
# Security/bootstrap
# -----------------------------
# Signs Authentik sessions and tokens. Generate a fresh one per install, e.g.
#   openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# -----------------------------
# Published ports
# -----------------------------
# Authentik listens internally on 9000 (HTTP) / 9443 (HTTPS).
AUTHENTIK_HTTP_PUBLISHED_PORT=9000
AUTHENTIK_HTTPS_PUBLISHED_PORT=9443

# -----------------------------
# Postgres settings
# -----------------------------
# Default database, auto-created by the image entrypoint and used by
# Authentik (AUTHENTIK_POSTGRESQL__NAME in docker-compose.yml). The app's
# `fabric_sync` database is created alongside it via
# docker/postgres-init.sql.
POSTGRES_DB=authentik
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
# Host port Postgres is published on. The backend (run outside Docker via
# `cargo run`) connects here; matches DATABASE_URL's default above.
POSTGRES_PUBLISHED_PORT=5432

# -----------------------------
# Invoice document (backend)
# -----------------------------
# Printed on the invoice PDF (GET /invoices/:id/document). The backend reads
# these from its own environment rather than this file — it has no dotenv
# loader (see backend/src/config.rs) — so export them alongside DATABASE_URL
# when running `cargo run`. Every one is optional; blanks are simply omitted
# from the document.
COMPANY_NAME_EN=Fabric Sync
COMPANY_NAME_AR=فابريك سينك
COMPANY_VAT_NUMBER=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS_EN=
COMPANY_ADDRESS_AR=
COMPANY_PHONE=
COMPANY_EMAIL=
# A `data:` URI, not a URL — the document has to stay self-contained.
COMPANY_LOGO_DATA_URL=
# Point at backend/templates to restyle the invoice without a rebuild; unset
# uses the copy compiled into the binary.
INVOICE_TEMPLATE_DIR=
