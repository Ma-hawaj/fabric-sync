# Backend env for local development (`cargo run` from this directory).
#
# Setup:
#   cp backend/.env.example backend/.env
#
# The backend loads this file via `dotenvy` in main.rs. Note that
# `backend/.env` SHADOWS the repo-root `.env`: dotenvy stops at the first
# `.env` found walking up from the working directory, so every variable the
# backend reads must live here — nothing is inherited from the root file
# (which is for `docker compose` only).

# -----------------------------
# Server
# -----------------------------
# Port 8000 keeps clear of the Vite dev server on :3000; it is also the
# target of Vite's `/api` proxy (see frontend/vite.config.ts BACKEND_URL).
PORT=8000
# Matches the compose Postgres below (POSTGRES_* in the root .env):
# same user, password, host port, and the `fabric_sync` database created
# via docker/postgres-init.sql.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fabric_sync
# Directory the built frontend (`vite build` output) is served from.
# Unset means `./static` next to the server binary — the Dockerfile copies
# the frontend `dist/` there. Not needed for plain `cargo run`.
# STATIC_DIR=static

# -----------------------------
# OIDC issuer (Zitadel)
# -----------------------------
# Zitadel serves discovery at the instance root, so this is the bare origin
# (no per-provider path). `OIDC_*` spellings also work as fallbacks.
OAUTH_ISSUER_URL=http://localhost:8080
# OIDC_ISSUER_URL=http://localhost:8080
# API resource-server credential used only to introspect end-user tokens
# (see "Zitadel setup" in README.md).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Only set if Zitadel is configured with a non-standard introspection
# endpoint — otherwise discovery advertises it.
# OAUTH_INTROSPECTION_URL=
# Leave unset unless verified: if a valid access token gets a 401, check the
# `aud` claim Zitadel puts on tokens issued to the SPA client against this —
# either add the backend's client ID as an audience in Zitadel, or leave this
# unset locally.
# OAUTH_RESOURCE_AUDIENCE=

# -----------------------------
# Zitadel user directory
# -----------------------------
# Backs GET /users (the order-stage assignee picker) with Zitadel's real
# user directory. Both are required; leaving either unset fails the backend
# at startup (see backend/src/features/users/zitadel.rs).
#
# This is a dedicated Zitadel machine user (service account), separate from
# OAUTH_CLIENT_ID/OAUTH_CLIENT_SECRET above (that pair authenticates the API
# resource-server credential used only for introspecting end-user tokens,
# and can't be granted directory-read permissions of its own). One-time
# setup in the Zitadel console (http://localhost:8080/ui/console):
#   1. Users > New > Machine user (e.g. "fabric-sync-backend").
#   2. That user > Keys/Secrets > add a Client Secret. Zitadel only shows it
#      once — copy it into ZITADEL_USERS_CLIENT_SECRET below immediately.
#   3. Organization > Managers > grant that machine user the
#      "Org User Manager" (ORG_USER_MANAGER) role so it can read users.
#   4. For the Users table's Roles column, the machine user additionally
#      needs grant-read (user grants search). Without it roles come back
#      empty — the picker still works, and the backend logs a warning.
ZITADEL_USERS_CLIENT_ID=
ZITADEL_USERS_CLIENT_SECRET=

# -----------------------------
# Printed-document timezone
# -----------------------------
# IANA timezone the invoice and order PDFs write dates in — the database
# stores UTC, and a date printed in the wrong zone is a wrong date on the
# paper. An unknown name refuses to boot rather than silently printing UTC.
TIMEZONE=Asia/Bahrain

# -----------------------------
# Dev seed
# -----------------------------
# Loads backend/seeds/dev_seed.sql at startup — sample locations, materials,
# products, customers, invoices, and orders spread across the tracking stages.
# It refuses to run against a database that already has data, so it can never
# overwrite real rows.
SEED_DEV_DATA=false
# Loads the staff-managed design catalog and bundled illustrations from
# backend/seeds/design_options.sql. Safe to rerun; staff image replacements are
# preserved. Keep false unless this deployment needs the initial catalog.
SEED_DESIGN_OPTIONS=false

# -----------------------------
# Invoice document
# -----------------------------
# Printed on the invoice document (GET /invoices/:id/document). Every one is
# optional; blanks are simply omitted from the document.
COMPANY_NAME_EN=Fabric Sync
COMPANY_NAME_AR=فابريك سينك
COMPANY_VAT_NUMBER=
COMPANY_CR_NUMBER=
COMPANY_ADDRESS_EN=
COMPANY_ADDRESS_AR=
COMPANY_PHONE=
COMPANY_EMAIL=
# A `data:` URI, not a URL — the document has to stay self-contained.
COMPANY_LOGO_DATA_URL=
# Point at backend/templates to restyle the invoice without a rebuild; unset
# uses the copy compiled into the binary.
INVOICE_TEMPLATE_DIR=
