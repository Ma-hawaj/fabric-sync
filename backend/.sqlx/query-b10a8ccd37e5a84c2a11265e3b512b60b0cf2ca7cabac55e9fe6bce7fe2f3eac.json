{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.order_id,\n            p.stage_id,\n            p.status,\n            p.completed_at,\n            p.location_id,\n            b.name AS \"location?\",\n            p.notes\n        FROM order_stage_progress p\n        LEFT JOIN branch b ON b.id = p.location_id\n        WHERE p.order_id = ANY($1)\n        ",
