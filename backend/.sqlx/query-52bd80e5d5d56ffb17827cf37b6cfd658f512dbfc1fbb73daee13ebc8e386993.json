  "query": "\n        UPDATE branch\n        SET name = COALESCE($2, name),\n            receives_orders = COALESCE($3, receives_orders),\n            holds_stock = COALESCE($4, holds_stock),\n            is_active = COALESCE($5, is_active)\n        WHERE id = $1\n        RETURNING id, name, receives_orders, holds_stock, is_active\n        ",
