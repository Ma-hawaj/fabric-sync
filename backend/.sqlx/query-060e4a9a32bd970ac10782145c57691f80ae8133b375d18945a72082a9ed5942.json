{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            i.invoice_number,\n            i.invoice_date,\n            i.target_date,\n            i.branch_id,\n            b.name AS \"branch_name?\",\n            i.discount::float8 AS \"discount!\",\n            i.discount_unit,\n            i.customer_id\n        FROM invoices i\n        LEFT JOIN branch b ON b.id = i.branch_id\n        WHERE i.id = $1\n        ",
