{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            g.id,\n            g.code,\n            g.initial_amount::float8 AS \"initial_amount!\",\n            g.balance::float8 AS \"balance!\",\n            g.customer_id,\n            c.name AS \"customer_name?\",\n            g.expires_on,\n            g.is_active\n        FROM gift_cards g\n        LEFT JOIN customers c ON c.id = g.customer_id\n        WHERE g.code = $1\n        ",
