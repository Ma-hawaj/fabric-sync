  "query": "\n        SELECT g.code, ii.line_total::float8 AS \"amount!\", g.expires_on, g.bought_for, g.recipient_phone\n        FROM invoice_items ii\n        JOIN gift_cards g ON g.id = ii.gift_card_id\n        WHERE ii.invoice_id = $1 AND ii.kind = 'gift_card'\n        ORDER BY ii.id\n        ",
