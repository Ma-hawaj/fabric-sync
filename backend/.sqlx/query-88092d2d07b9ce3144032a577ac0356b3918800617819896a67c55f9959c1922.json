{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            i.invoice_number,\n            i.vat_rate::float8 AS \"vat_rate!\",\n            i.invoice_date,\n            i.target_date,\n            i.urgent_charge::float8 AS \"urgent_charge!\",\n            i.collection_method,\n            i.branch_id,\n            i.issuing_branch_id,\n            i.issuing_branch_name,\n            b.name AS \"branch_name?\",\n            i.discount::float8 AS \"discount!\",\n            i.discount_unit,\n            i.customer_id\n        FROM invoices i\n        LEFT JOIN branch b ON b.id = i.branch_id\n        WHERE i.id = $1\n        ",
